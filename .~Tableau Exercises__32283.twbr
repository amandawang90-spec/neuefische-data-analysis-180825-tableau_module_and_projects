              <calculation class='tableau' formula='if[Parameters].[Parameter 4] = &apos;Quarter&apos; then datename(&apos;year&apos;, [Order Date]) + datename(&apos;quarter&apos;, [Order Date])&#10;elseif [Parameters].[Parameter 4] = &apos;Year&apos; then datename(&apos;year&apos;, [Order Date])&#10;elseif [Parameters].[Parameter 4] = &apos;Month&apos; then datename(&apos;year&apos;, [Order Date]) + datename(&apos;month&apos;, [Order Date])&#10;else datename(&apos;year&apos;, [Order Date]) + datename(&apos;week&apos;, [Order Date])&#10;end' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='n#,##0;-#,##0' name='[Sales]' role='measure' type='quantitative' />
