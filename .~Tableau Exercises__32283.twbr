    <worksheet name='Sales by Product Name Check'>
      <table>
        <view>
          <datasources>
            <datasource name='Sample - Superstore' />
          </datasources>
          <datasource-dependencies datasource='Sample - Superstore'>
            <column caption='Product Name Check' datatype='string' name='[Calculation_1420463474771697673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([Product Name]),&quot;office&quot;) THEN &quot;Mentions Office&quot;&#10;ELSE &quot;No Mention&quot;&#10;END' />
            </column>
