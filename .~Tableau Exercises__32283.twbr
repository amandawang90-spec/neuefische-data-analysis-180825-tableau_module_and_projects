      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Sales or Profit' datatype='real' name='[Calculation_1420463474709499904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Sales&apos; THEN [Sales]&#10;ELSE [Profit]&#10;END' />
      </column>
      <column caption='State &amp; Region Category' datatype='string' name='[Calculation_1420463474721447937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [State/Province]&#10;    WHEN &quot;California&quot; THEN &quot;West&quot;&#10;    WHEN &quot;Oregon&quot; THEN &quot;West&quot;&#10;    WHEN &quot;Washington&quot; THEN &quot;West&quot;&#10;    WHEN &quot;New York&quot; THEN &quot;East&quot;&#10;    WHEN &quot;Florida&quot; THEN &quot;South&quot;&#10;    ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='High Priority' datatype='string' name='[Calculation_1420463474725445635]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Ship Mode], &apos;First&apos;) THEN &apos;High Priority&apos;&#10;ElSE &apos;Normal&apos;&#10;END' />
      </column>
      <column caption='Sales vs Window Cat Avg' datatype='real' name='[Calculation_1420463474739933189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Sales]) / WINDOW_AVG(sum([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Weekday Number' datatype='integer' name='[Calculation_1420463474748710918]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;, [Order Date])' />
      </column>
      <column caption='Dynamic Date Group' datatype='string' name='[Calculation_1420463474753708040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if[Parameters].[Parameter 4] = &apos;Quarter&apos; then datename(&apos;year&apos;, [Order Date]) + datename(&apos;quarter&apos;, [Order Date])&#10;elseif [Parameters].[Parameter 4] = &apos;Year&apos; then datename(&apos;year&apos;, [Order Date])&#10;elseif [Parameters].[Parameter 4] = &apos;Month&apos; then datename(&apos;year&apos;, [Order Date]) + datename(&apos;month&apos;, [Order Date])&#10;else datename(&apos;year&apos;, [Order Date]) + datename(&apos;week&apos;, [Order Date])&#10;end' />
      </column>
      <column caption='Product Name Check' datatype='string' name='[Calculation_1420463474771697673]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Product Name]),&quot;office&quot;) THEN &quot;Mentions Office&quot;&#10;ELSE &quot;No Mention&quot;&#10;END' />
      </column>
      <column caption='Customer Name Abbreviation' datatype='string' name='[Calculation_1420463474775322634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(SPLIT([Customer Name], &quot; &quot;, 1), 1)+ &quot; &quot; + SPLIT([Customer Name], &quot; &quot;, 2)' />
      </column>
      <column caption='Sum Profit' datatype='real' name='[Calculation_1420463475145523218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])' />
      </column>
      <column caption='Region Security Filter' datatype='boolean' name='[Calculation_2271714174459527168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Regional Manager] = [Parameters].[Parameter 5]' />
      </column>
      <column caption='Profitability' datatype='string' name='[Calculation_6579055371862405120]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM(Profit) &gt; 20000 THEN &apos;highly profitable&apos;&#10;ELSEIF SUM(Profit) &gt; 0 THEN &apos;profitable&apos;&#10;ELSE &apos;not profitable&apos;&#10;END' />
      </column>
      <column caption='Costs' datatype='real' name='[Calculation_6579055372689645572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales] - [Profit]' />
      </column>
      <column caption='My Sub-Categories' datatype='string' name='[Calculation_6579055372692615173]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sub-Category] = &quot;Art&quot;&#10;    OR [Sub-Category] = &quot;Bookcases&quot;&#10;THEN &quot;My Sub-Categories&quot;&#10;ELSE &quot;Others&quot;&#10;END' />
      </column>
