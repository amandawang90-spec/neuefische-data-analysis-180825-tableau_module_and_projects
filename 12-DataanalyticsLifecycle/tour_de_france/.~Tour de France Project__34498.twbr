      <aliases enabled='yes' />
      <column caption='Winner Frequency' datatype='string' name='[Calculation_1125907630821430]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNT([Winner])&gt; 1 THEN &quot;&gt;1&quot;&#10;ELSE &quot;=1&quot;&#10;END' />
      </column>
      <column caption='Finish City Latitude' datatype='real' name='[Calculation_1125907656654903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT( SPLIT( SPLIT([Start/Finish City Coordinates], &quot; - &quot;, 2), &quot;,&quot;, 1 ) )' />
      </column>
      <column caption='Finish City Longitude' datatype='real' name='[Calculation_1125907656753208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT( SPLIT( SPLIT([Start/Finish City Coordinates], &quot; - &quot;, 2), &quot;,&quot;, 2 ) )' />
      </column>
      <column caption='Route' datatype='spatial' name='[Calculation_1125907859382337]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKELINE(MAKEPOINT([Calculation_14214493907763397], [Calculation_14214493907853510]), MAKEPOINT([Calculation_1125907656654903], [Calculation_1125907656753208]))' />
      </column>
      <column caption='Finish City' datatype='string' name='[Calculation_14214493904609475]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Start/Finish Cities], &quot; - &quot;, 2)' />
      </column>
      <column caption='Start City' datatype='string' name='[Calculation_14214493905088708]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Start/Finish Cities], &quot; - &quot;, 1)' />
      </column>
      <column aggregation='Avg' caption='Start City Latitude' datatype='real' name='[Calculation_14214493907763397]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative'>
        <calculation class='tableau' formula='FLOAT( SPLIT( SPLIT([Start/Finish City Coordinates], &quot; - &quot;, 1), &quot;,&quot;, 1 ) )' />
      </column>
      <column aggregation='Avg' caption='Start City Longitude' datatype='real' name='[Calculation_14214493907853510]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative'>
        <calculation class='tableau' formula='FLOAT( SPLIT( SPLIT([Start/Finish City Coordinates], &quot; - &quot;, 1), &quot;,&quot;, 2 ) )' />
      </column>
      <column caption='Start Date' datatype='date' datatype-customized='true' name='[Calculation_14214493909008583]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;MM/dd/yyyy&quot;, SPLIT([Start/Finish Dates], &apos; - &apos;,1) )) ' />
      </column>
      <column caption='Finish Date' datatype='date' datatype-customized='true' name='[Calculation_14214493909106888]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;MM/dd/yyyy&quot;, SPLIT([Start/Finish Dates], &quot; - &quot;, 2) )) ' />
      </column>
      <column caption='Year' datatype='integer' name='[Calculation_14214493911105737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Calculation_14214493909008583])' />
      </column>
      <column caption='% Finished' datatype='real' name='[Calculation_14214493927784651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Finishers]/[Entrants]' />
      </column>
      <column caption='French or not French' datatype='string' name='[Calculation_14214493932392652]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Winner&apos;s Nationality], &quot;France&quot;) THEN &quot;French&quot;&#10;ELSE &quot;Non-French&quot;&#10;END' />
      </column>
      <column caption='Check France ' datatype='string' name='[Calculation_14214493933854925]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF TRIM([Winner&apos;s Nationality]) = &quot;France&quot; THEN &quot;French&quot;&#10;ELSE &quot;Non-French&quot;&#10;END' />
      </column>
      <column caption='Filter France' datatype='string' name='[Calculation_14214493936246990]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Winner&apos;s Nationality] = &quot; France&quot; THEN &quot;French&quot; ELSE &quot;Non-French&quot; END' />
      </column>
      <column caption='Rank Winners' datatype='integer' name='[Calculation_14214493981569231]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Parameters].[Parameter 1]), &quot;desc&quot;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
